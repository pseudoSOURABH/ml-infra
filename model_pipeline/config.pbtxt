name: "clinical_assertion"
platform: "onnxruntime_onnx"
max_batch_size: 8  # Enable batching for throughput

# Input configuration
input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]  # Variable sequence length
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "token_type_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

# Output configuration
output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ -1, 3 ]  # Batch size x 3 classes
  }
]

# Instance group - optimize for CPU
instance_group [
  {
    count: 2  # Multiple instances for parallelism
    kind: KIND_CPU
  }
]

# Dynamic batching for throughput
dynamic_batching {
  preferred_batch_size: [ 4, 8 ]
  max_queue_delay_microseconds: 10000  # 10ms max wait
}

# Optimization settings
optimization {
  execution_accelerators {
    cpu_accelerators {
      name: "openvino"  # Optional: use if OpenVINO available
    }
  }
  graph {
    level: 2  # Graph optimization level
  }
}

# Performance tuning
parameters {
  key: "cpu_threads"
  value: { string_value: "4" }
}
parameters {
  key: "inter_op_parallelism"
  value: { string_value: "2" }
}
parameters {
  key: "intra_op_parallelism"
  value: { string_value: "2" }
}