name: "clinical_assertion"
platform: "onnxruntime_onnx"
max_batch_size: 0

# Input configuration: Full shape [Batch, Sequence]
input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1, 512 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ -1, 512 ]
  },
  {
    name: "token_type_ids"
    data_type: TYPE_INT64
    dims: [ -1, 512 ]
  }
]

# Output configuration: Full shape [Batch, Classes]
output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ -1, 3 ]
  }
]

# CPU Optimizations (Safe for this model)
instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

# You can re-enable dynamic batching *after* the model loads successfully.
# dynamic_batching { ... }

optimization {
  graph { level: 2 }
}

parameters [
  { key: "cpu_threads"          value: { string_value: "4" } },
  { key: "inter_op_parallelism" value: { string_value: "2" } },
  { key: "intra_op_parallelism" value: { string_value: "2" } }
]