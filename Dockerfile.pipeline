# Dockerfile.pipeline
# Pre-bakes all heavy ML dependencies so Cloud Build doesn't reinstall them every run.
FROM python:3.12-slim

WORKDIR /workspace

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements first (layer-cached by Docker)
COPY model_pipeline/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Default workdir for Cloud Build
WORKDIR /workspace