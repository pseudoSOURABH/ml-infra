FROM python:3.12-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

COPY model_pipeline/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Bake the HF model into the image at build time.
# This runs ONCE when the image is built and is then layer-cached.
# On subsequent Cloud Build runs the cached image is pulled and the
# 430MB download never happens again — not during build, not at runtime.
ENV HF_HOME=/hf_cache \
    TRANSFORMERS_OFFLINE=0 \
    HF_HUB_DISABLE_TELEMETRY=1

RUN python -c "\
from optimum.onnxruntime import ORTModelForSequenceClassification; \
from transformers import AutoTokenizer; \
m = ORTModelForSequenceClassification.from_pretrained('bvanaken/clinical-assertion-negation-bert', export=True); \
m.save_pretrained('/hf_cache/clinical_assertion_onnx'); \
t = AutoTokenizer.from_pretrained('bvanaken/clinical-assertion-negation-bert'); \
t.save_pretrained('/hf_cache/clinical_assertion_onnx'); \
print('Model and tokenizer baked into image.')"

# After baking, force offline mode so the container CANNOT hit HF at runtime
ENV TRANSFORMERS_OFFLINE=1 \
    HF_HUB_OFFLINE=1

COPY model_pipeline/ /workspace/model_pipeline/
ENV PYTHONPATH="/workspace/model_pipeline"

WORKDIR /workspace