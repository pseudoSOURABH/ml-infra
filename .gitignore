# .gitignore
# ==================== PYTHON ====================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/
venv.bak/

# pip
pip-log.txt
pip-delete-this-directory.txt

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pytest
.pytest_cache/

# ==================== ML / MODEL ARTIFACTS ====================
# Large model files (never commit trained models to Git)
*.pt
*.pth
*.bin
*.onnx
*.onnx.data
*.tflite
*.pb
*.pbtxt
*.mlmodel
*.mlpackage/
coreml_model/

# Model cache directories
.huggingface/
.transformers_cache/
.cache/
torch_hub_cache/

# Output directories (generated during pipeline)
output/
artifacts/
exports/
triton_model_repository/

# ==================== ENVIRONMENT & SECRETS ====================
# Environment variables (store in Secret Manager, not Git)
.env
.env.local
.env.*.local
*.env

# Credentials / keys (use GCP Secret Manager)
*.pem
*.key
*.p12
*.json
!cloudbuild.yaml  # Keep Cloud Build config
!k8s/             # Keep K8s manifests (no secrets in them)

# ==================== IDE / EDITOR ====================
# VS Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Vim / Emacs
*.swp
*.swo
*~
*.bak

# ==================== OS / SYSTEM ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*

# ==================== DOCKER / KUBERNETES ====================
# Docker (keep Dockerfiles, ignore build context artifacts)
.docker/
docker-compose.override.yml

# Kubernetes (keep manifests, ignore generated/sealed secrets)
*.secrets.yaml
*.gpg
.kube/

# ==================== TESTING / COVERAGE ====================
# Coverage reports
htmlcov/
.coverage
.coverage.*
*.cover

# Hypothesis
.hypothesis/

# ==================== DOCUMENTATION ====================
# Sphinx
docs/_build/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ==================== CLOUD BUILD / GCP ====================
# Local gcloud config (project-specific, not for sharing)
.gcloud/
configurations/

# Build logs (generated)
build-*.log
cloudbuild-*.log

# ==================== MISC ====================
# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Node modules (if frontend uses npm)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE project files
*.sublime-project
*.sublime-workspace
.project
.settings/

# ==================== EXCEPTIONS (Force-include) ====================
# Keep these even if they match above patterns
!README.md
!requirements.txt
!requirements-dev.txt
!Makefile
!.gitignore
!.cloudignore